# Copier en .env.local et remplir (ne jamais committer de secrets).

# Clé API OpenAI pour le chat "IA de Romain" (serveur uniquement)
OPENAI_API_KEY=
# Modèle utilisé par le chat (vide = gpt-6-luna ; doit accepter reasoning "none")
CHAT_MODEL=
# Nombre max de messages par visiteur et par minute (vide = 8)
CHAT_RATE_LIMIT_PER_MINUTE=
# Plafond global de requêtes chat par jour, garde-fou budget (vide = 500)
CHAT_DAILY_GLOBAL_LIMIT=
# Redis Upstash (offre gratuite) pour des limites partagées entre instances.
# OBLIGATOIRE en production Vercel : sans lui, le chat y reste désactivé.
# (L'intégration Upstash du Marketplace Vercel pose KV_REST_API_URL / KV_REST_API_TOKEN,
# également acceptés.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optionnel : secret de signature de l'historique du chat (vide = dérivé de OPENAI_API_KEY)
CHAT_SIGNING_SECRET=
# 1 = ne pas vérifier Vercel BotID (next start en local, CI, tests). Ignoré en production.
BOTID_DISABLED=
# URL publique du site (défaut : https://romaincampanha.ch)
NEXT_PUBLIC_SITE_URL=
